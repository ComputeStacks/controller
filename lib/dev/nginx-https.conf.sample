# Optional HTTPS front door for the dev workstation. See "Optional: HTTPS on a
# real domain" in doc/development.md.
#
# Replace dev.example.com with your domain and 10.0.0.0/24 with the private
# network the node sits on. The other two allow ranges are Tailscale's (IPv4
# CGNAT range and the tailnet's IPv6 prefix); drop them if you don't use it.
# Install as /etc/nginx/sites-available/dev.conf, symlink it into
# sites-enabled/, and remove the default site.

map $http_upgrade $connection_upgrade {
  default upgrade;
  ''      close;
}

ssl_certificate     /etc/nginx/ssl/dev.example.com.fullchain.pem;
ssl_certificate_key /etc/nginx/ssl/dev.example.com.key;
ssl_protocols       TLSv1.2 TLSv1.3;

proxy_http_version 1.1;
proxy_set_header Host              $host;
proxy_set_header X-Real-IP         $remote_addr;
proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
proxy_set_header X-Forwarded-Proto https;
proxy_set_header X-Forwarded-Host  $host;
proxy_set_header X-Forwarded-Port  443;
proxy_set_header Upgrade           $http_upgrade;
proxy_set_header Connection        $connection_upgrade;
proxy_read_timeout 300s;
client_max_body_size 512m;

# Plain HTTP: redirect allowed clients, refuse everyone else.
server {
  listen 80 default_server;
  listen [::]:80 default_server;
  server_name _;
  allow 10.0.0.0/24; allow 100.64.0.0/10; allow fd7a:115c:a1e0::/48;
  deny all;
  return 301 https://$host$request_uri;
}

# Unknown names over HTTPS: close the connection.
server {
  listen 443 ssl default_server;
  listen [::]:443 ssl default_server;
  server_name _;
  return 444;
}

# The controller (Procfile web on :3005).
server {
  listen 443 ssl; listen [::]:443 ssl;
  server_name cs.dev.example.com;
  allow 10.0.0.0/24; allow 100.64.0.0/10; allow fd7a:115c:a1e0::/48; deny all;
  location / { proxy_pass http://127.0.0.1:3005; }
}

# Guacamole, on GUAC_PORT from .envrc (55010 in envrc.sample).
server {
  listen 443 ssl; listen [::]:443 ssl;
  server_name guac.dev.example.com;
  allow 10.0.0.0/24; allow 100.64.0.0/10; allow fd7a:115c:a1e0::/48; deny all;
  location = / { return 302 /guacamole/; }
  location / { proxy_pass http://127.0.0.1:55010; }
}

# Add one server block per other app you run on the workstation.

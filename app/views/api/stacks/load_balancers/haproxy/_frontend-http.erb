  http-request set-header X-Real-IP %[src]
  http-request set-header X-Forwarded-For %[src]
  http-request set-header X-Real-IP %[var(txn.client_ip)] if proxied_conn { var(txn.client_ip) -m found }
  http-request set-header X-Forwarded-For %[var(txn.client_ip)] if proxied_conn { var(txn.client_ip) -m found }

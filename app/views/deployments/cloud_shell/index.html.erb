<% content_for :title, "#{@deployment.name} Cloud Shell" %>
<% content_for :breadcrumb do %>
  <div class="row has-breadcrumb">
    <ol class="breadcrumb">
      <li><%= link_to "Projects", "/deployments" %></li>
      <li><%= link_to @deployment.name, deployments_path(@deployment) %></li>
      <li class="active">Cloud Shell</li>
    </ol>
  </div>
<% end %>

<div class="row">
  <div class="col-xs-12">

    <p>There was a problem loading your session.</p>
    <p><strong>Errors</strong></p>
    <ul>
      <% @shell_errors.each do |i| %>
        <li><%= i %></li>
      <% end %>
    </ul>
  </div>
</div>

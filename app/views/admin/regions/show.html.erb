<% content_for :breadcrumb do %>
  <div class="row has-breadcrumb">
    <ol class="breadcrumb">
      <li><%= link_to "Regions", "/admin/locations" %></li>
      <li class="active"><%= @region.name %></li>
    </ol>
  </div>
<% end %>

<div class="row">
  <div class="col-md-8 col-xs-6"><p class="lead"><%= @region.name %></p></div>
  <div class="col-md-4 col-xs-6 text-right">

    <% if @region.can_migrate_network_driver? %>
      <%= link_to "Migrate Network Driver",
      "#{admin_region_url(@region)}/network_migrate",
      method: :post,
      data: {
        confirm: @region.ipv6_egress? ?
          "Are you sure? This will rebuild all containers. IPv6 Egress is enabled on this zone, so this will also convert every existing project in it to dual-stack." :
          "Are you sure? This will rebuild all containers.",
      },
      class: "btn btn-warning" %>
    <% end %>

    <%= link_to "Rebuild Container Networks",
    admin_region_rebuild_networks_path(@region),
    method: :post,
    data: {
      confirm: @region.ipv6_egress? ?
        "Are you sure? This will rebuild all containers. IPv6 Egress is enabled on this zone, so this will also convert every existing project in it to dual-stack." :
        "Are you sure? This will rebuild all containers.",
    },
    class: "btn btn-warning" %>

    <%= link_to icon("fa-solid", "wrench"),
    edit_admin_region_url(@region),
    class: "btn btn-default" %>

    <%= link_to icon("fa-solid", "trash"),
    admin_region_url(@region),
    method: :delete,
    data: {
      confirm: "Are you sure?",
    },
    class: "btn btn-danger" %>
  </div>
</div>
<%# Columns only: no agent calls, so this costs two queries however many nodes. %>
<% maint_summary = Nodes::MaintenanceStatusPresenter.summary(@region.nodes) %>
<% pending_syncs = Nodes::MaintenanceStatusPresenter.pending_agent_syncs([@region.id]) %>
<% if maint_summary["nodes_in_maintenance"].positive? || maint_summary["nodes_with_warnings"].positive? || pending_syncs["pending"].positive? || pending_syncs["dead"].positive? %>
  <div class="row" id="region-maintenance-summary">
    <div class="col-xs-12">
      <ul class="list-unstyled">
        <% if maint_summary["nodes_in_maintenance"].positive? || maint_summary["nodes_with_warnings"].positive? %>
          <li>
            <b>Maintenance:</b>
            <%= maint_summary["nodes_in_maintenance"] %> of <%= pluralize maint_summary["nodes_total"], "node" %> in maintenance,
            <%= maint_summary["nodes_quiesced"] %> quiesced<% if maint_summary["nodes_with_warnings"].positive? %>,
              <span class="text-danger"><%= maint_summary["nodes_with_warnings"] %> with warnings</span><% end %>.
            <% maint_summary["nodes"].each do |n| %>
              <%= link_to n["label"], "/admin/nodes/#{n["id"]}/edit" %>
              <small class="text-muted">(<%= n["held_by"].join(" + ") %><%= ", since #{l n["since"], format: :short}" if n["since"] %>)</small>
            <% end %>
          </li>
        <% end %>
        <% if pending_syncs["pending"].positive? || pending_syncs["dead"].positive? %>
          <li>
            <b>Agent syncs:</b>
            <%= pluralize pending_syncs["pending"], "agent sync" %> pending<% if pending_syncs["oldest_at"] %>
              (oldest <%= time_ago_in_words pending_syncs["oldest_at"] %>)<% end %>,
            <span class="<%= pending_syncs["dead"].positive? ? "text-danger" : "text-muted" %>"><%= pending_syncs["dead"] %> dead</span>
            <% if pending_syncs["dead"].positive? %>
              <%= link_to "Retry dead", "/admin/regions/#{@region.id}/retry_dead_agent_syncs",
                method: :post,
                data: {confirm: "Retry every dead agent sync in this availability zone?"},
                class: "btn btn-xs btn-default" %>
            <% end %>
          </li>
        <% end %>
      </ul>
    </div>
  </div>
<% end %>
<br/>
<div class="row">
  <%# No `refresh`: this block re-rendered the whole node list every 6.5s, and
      each render issues a Prometheus read per metric per node -- a standing load
      against the metrics server for as long as a tab stayed open. Loads once per
      page view now, like the dashboard's zone rows. %>
  <div
    class="col-xs-12 remote-resource"
    data-url="/admin/regions/<%= @region.id %>/nodes"
  >
    <p class="text-center"><%= icon("fa-solid fa-spin", "rotate") %></p>
  </div>
</div>

<% content_for :breadcrumb do %>
  <div class="row has-breadcrumb">
    <ol class="breadcrumb">
      <li><%= link_to @node.location.name, "/admin/locations/#{@node.location.id}" %></li>
      <li><%= link_to @node.region.name, "/admin/regions/#{@node.region.id}" %></li>
      <li class="active"><%= @node.label %></li>
    </ol>
  </div>
<% end %>

<div class="row">
  <div class="col-md-12">
    <p class="lead">
      Events for <%= @node.label %>
    </p>
  </div>
</div>
<div class="row">
  <div class="col-md-6">
    <div class="panel <%= node_status_header(@node) %>">
      <div class="panel-heading">
        <div class="panel-title">
          <%= node_current_state(@node) %>
          <%= link_to icon("fa-solid", "wrench"), "/admin/nodes/#{@node.id}/edit", class: "pull-right", title: "Edit node and maintenance" %>
        </div>
      </div>
      <div class="panel-body">
        <%= render partial: "admin/nodes/maintenance_status", locals: { node: @node } %>
      </div>
    </div>
  </div>
</div>
<div class="row">
  <div class="col-md-12">
    <div class="row">
      <div class="col-md-12">
        <%= render partial: "admin/event_logs/list", locals: { logs: @logs, root_path: "/admin/nodes/#{@node.id}/events" } %>
      </div>
    </div>
    <div class="row">
      <div class="col-md-12">
        <%= will_paginate @logs %>
      </div>
    </div>
  </div>
</div>

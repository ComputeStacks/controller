<% content_for :breadcrumb do %>
  <div class="row has-breadcrumb">
    <ol class="breadcrumb pull-left" style="padding-top:10px;">
      <li><%= link_to "Projects", "/deployments" %></li>
      <li><%= link_to @deployment.name, deployments_path(@deployment) %></li>
      <li><%= link_to @service.label, container_service_path(@service) %></li>
      <li class="active"><%= t "deployments.setup.title" %></li>
    </ol>
    <ol class="breadcrumb breadcrumb-action text-right">
      <%= render partial: "deployments/cloud_shell/button",
      locals: {
        deployment: @deployment,
      } %>
    </ol>
  </div>
<% end %>

<div class="row">
  <div class="col-md-12"><%= image_content_general @service.container_image %></div>
</div>

<% if @service.container_image.role == 'mysql' && @service.deployment.container_images.where(role: 'pma').exists? %>
  <%= render partial: "container_services/help/mysql_pma",
  locals: {
    service: @service,
  } %>
<% end %>

<%= unless @service.sftp_containers.empty?
  render partial: "container_services/help/sftp", locals: { service: @service }
end %>

<%= if @service.ingress_rules.where(proto: "http").exists?
  render partial: "container_services/help/custom_domains",
  locals: {
    service: @service,
  }
end %>
<%= unless @service.ingress_rules.empty?
  render partial: "container_services/help/ingress",
  locals: {
    service: @service,
  }
end %>

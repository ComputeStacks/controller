# vim syntax=ruby
ruby "~> 3.4"

source 'https://rubygems.org'

git_source(:github) { |repo_name| "https://github.com/#{repo_name}" }

gem 'timeout', '~> 0.4'

gem 'rails', '~> 7.2'
gem 'json', '~> 2.12'

# Redis
gem "hiredis", "< 1"
gem "redis", "< 6"
gem 'redis-client', '< 1' # sidekiq

gem "connection_pool", "< 3" # Stay under v3.0 until Rails 8 upgrade.

gem 'rack-attack', '~> 6.7'

# Version constraints are the only thing standing between this app and a surprise
# dependency upgrade: there is no tracked Gemfile.lock (the root Gemfile is gitignored so
# an install can add engine path gems), so every image build resolves fresh. On 2026-09-04
# an unpinned sentry crossed a major version, turned per-query structured logging on by
# default, and took order placement down. Keep every runtime gem here constrained.
gem 'tzinfo-data', '~> 1.2026' # No source of timezone data could be found. (TZInfo::DataSourceNotFound)

gem 'rake', '~> 13'
gem 'sprockets', '~> 4.2'
gem 'sprockets-rails', '~> 3.5'
gem 'importmap-rails', '~> 2.1'
gem 'pg', '~> 1.5', platform: :ruby

gem 'httparty', '~> 0.23' # @deprecated for httprb
gem 'http', '~> 5.3'

gem 'geoip', '~> 1'

gem 'will_paginate', '~> 4'
gem 'api-pagination', '~> 6'

gem 'money-rails', '~> 1'
gem 'whois', '~> 6'

gem 'sidekiq', '~> 8'
gem 'sidekiq-unique-jobs', '~> 8'

# Logging
gem 'lograge', '~> 0.14'

# Authentication
gem 'devise', '~> 4.9'
gem 'bcrypt', '= 3.1.20'

gem "doorkeeper", "~> 5.8"

gem 'rotp', '~> 6.3'
gem 'rqrcode', '~> 3.1'
gem 'webauthn', '~> 3.4'

gem 'clockwork', '= 3.0.2'
gem 'http_accept_language', '= 2.1.1'

gem 'nokogiri', '~> 1'

gem 'country_select', '~> 11'
gem 'responders', '~> 3.1'

gem 'daemons', '= 1.4.1'
gem 'net-smtp', '~> 0.5.1'
gem 'slim', '~> 5.2'

gem 'chartkick', '~> 5'
gem 'groupdate', '~> 6'

gem 'ssh_data', '~> 2' # Generate & Validate SSH Keys
gem 'net-ssh', '~> 7'
gem 'ed25519', '~> 1.4'
gem 'bcrypt_pbkdf', '~> 1.1'  # Support ed25519 ssh keys for net-ssh.
gem 'highline', '~> 3' # Hide PW entered into net-ssh from logs and output.

# Markdown Support
gem 'github-markup', '~> 5'
gem 'redcarpet', '~> 3.6', platform: :ruby


# Pinned deliberately. There is no tracked Gemfile.lock (see .gitignore), so an
# unpinned gem resolves fresh on every CI image build -- 9.7.6 picked up sentry 7.0.0,
# which enables structured logging by default and emits a Sentry log event per SQL
# query. See config/initializers/sentry.rb. Move all three together.
gem "sentry-ruby", "~> 7.0.0"
gem "sentry-rails", "~> 7.0.0"
gem "sentry-sidekiq", "~> 7.0.0"

gem 'sass-rails', '= 6.0.0'
gem 'bootstrap-sass', '= 3.4.1'

gem 'rabl', '~> 0.17'
gem 'oj', '~> 3.16', platform: :ruby
gem 'jwt', '~> 2.10'

gem 'acme-client', '= 2.0.21'

gem 'versioncake', '= 4.1.1'

# Console
gem 'pry', '~> 0.16.0'
gem 'pry-rails', '~> 0.3.11'

gem 'fugit', '~> 1.11'
gem 'zaru', '~> 1.0'

gem 'acts-as-taggable-on', '~> 12'

gem 'liquid', '~> 5.8' # Used to generate variables in custom commands

##
# Used by CAA check to determine TLD for a domain.
gem 'domain_prefix', '~> 1' # https://github.com/postageapp/domain_prefix

gem 'dnsruby', '~> 1.72' # https://github.com/alexdalitz/dnsruby

gem 'prometheus-api-client', '~> 0.6'

#gem 'font-awesome-sass', '~> 6.4'
gem 'font-awesome-sass', '~> 6.7'

gem 'puma', '~> 8.0'

gem 'netaddr', '~> 2.0'

gem 'csv', '~> 3.3'

group :development do
  gem 'yard'
  gem 'listen'
  gem 'byebug', platforms: [:mri, :windows]
  gem "better_errors"
  gem "binding_of_caller"
  gem 'rack-cors'
  gem 'i18n-tasks'
  gem 'overmind'
end

group :test do
  gem 'minitest', '~> 5'
  gem 'minitest-reporters'
  gem 'capybara'
  gem 'selenium-webdriver'
  gem 'webmock'
end

group :development, :test do
  gem 'ruby-lsp', require: false
end
# ComputeStack Gems
gem 'autodns', github: 'ComputeStacks/autodns-ruby', ref: 'd045f63'
gem 'docker-api', github: 'ComputeStacks/docker-api', ref: 'd13e63f'
gem 'docker_registry', github: 'ComputeStacks/docker-registry-ruby', ref: '02d16e5'
gem 'docker_ssh', github: 'ComputeStacks/docker-ssh-ruby', ref: '0b01ab8'
gem 'docker_volume_local', github: 'ComputeStacks/docker-volume-local', ref: 'b6f066a'
gem 'docker_volume_nfs', github: 'ComputeStacks/docker-volume-nfs', ref: '2614c82'
gem 'pdns', github: 'ComputeStacks/powerdns-ruby', ref: '21a31b9'
gem 'whmcs', github: 'ComputeStacks/whmcs-ruby', ref: '7dc4f4e'
